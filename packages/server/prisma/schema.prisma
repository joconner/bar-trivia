generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  guest
  player
  host
  admin
}

model User {
  id           String            @id @default(uuid())
  role         UserRole
  displayName  String
  email        String?           @unique
  passwordHash String?
  createdAt    DateTime          @default(now())
  lastSeenAt   DateTime          @default(now())
  refreshTokens RefreshToken[]
  participants RoomParticipant[]
  hostedRooms  Room[]            @relation("RoomHost")
  ownedPacks   Pack[]
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  deviceLabel String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime
  revokedAt   DateTime?
  rotatedToId String?   @unique

  @@index([userId])
}

model Pack {
  id        String   @id @default(uuid())
  title     String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  games     Game[]
  rooms     Room[]
}

model Game {
  id               String     @id @default(uuid())
  packId           String
  pack             Pack       @relation(fields: [packId], references: [id], onDelete: Cascade)
  title            String
  position         Int
  lateJoinDefault  String     @default("open")
  tiebreakerMethod String     @default("response_time")
  phoneTextMode    String     @default("heads_up")
  createdAt        DateTime   @default(now())
  questions        Question[]

  @@index([packId])
}

model Question {
  id                  String @id @default(uuid())
  gameId              String
  game                Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  type                String @default("multiple_choice")
  prompt              String
  imageUrl            String?
  data                Json
  defaultTimerSeconds Int    @default(30)
  position            Int

  @@index([gameId])
}

model Room {
  id            String            @id @default(uuid())
  roomCode      String            @unique
  hostId        String
  host          User              @relation("RoomHost", fields: [hostId], references: [id])
  packId        String
  pack          Pack              @relation(fields: [packId], references: [id])
  currentGameId String?
  status        String            @default("lobby")
  createdAt     DateTime          @default(now())
  endedAt       DateTime?
  participants  RoomParticipant[]
  gameResults   GameResult[]

  @@index([hostId])
}

model RoomParticipant {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  roomCode    String
  displayName String
  joinedAt    DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)

  @@index([roomId])
  @@index([userId])
  @@index([roomCode])
}

model GameResult {
  id          String   @id @default(uuid())
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id])
  gameId      String
  completedAt DateTime @default(now())
  results     Json
}
