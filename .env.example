# Bar Trivia environment template. Copy to .env and fill in values.
#
#   cp .env.example .env
#
# Used by:
#   - docker-compose.yml (variable interpolation + injected into server container)
#   - the server in local-dev (loaded by dotenv from the repo root)
#
# .env is gitignored. Same filename for dev and prod; only the contents differ.

# --- Postgres (db credentials shared between the postgres container and the server) ---
POSTGRES_USER=bartrivia
POSTGRES_PASSWORD=bartrivia
POSTGRES_DB=bartrivia

# Connection string the server uses. In Docker the host is `postgres` (service
# name). In local-dev (server running outside Docker) use `localhost:5432`.
DATABASE_URL=postgresql://bartrivia:bartrivia@postgres:5432/bartrivia

# --- Server runtime ---
NODE_ENV=development

# 32+ byte random strings. Generate with: openssl rand -hex 32
JWT_SECRET=dev-jwt-secret-change-in-production-32bytes-min
COOKIE_SECRET=dev-cookie-secret-change-in-production-32b
